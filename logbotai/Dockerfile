RUN npm install
RUN npm run build
 
## Run Environment
FROM nginx:alpine
# Copy build artefacts
COPY --from=build-env /app/build /usr/share/nginx/html
COPY --from=build-env /app/nginx/nginx.conf /etc/nginx/conf.d/*.conf
